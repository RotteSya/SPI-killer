# NotchSPI official pay-as-you-go server — configuration catalog.
# This file is NOT loaded automatically by `npm start` or `node src/index.ts`.
# Local development uses `scripts/dev.sh` (mock provider, in-memory/SQLite, stub top-up).
# Production values are set on the host (Vercel env). Defaults live in src/config.ts.

# --- Server ---
HOST=0.0.0.0
PORT=8787
# Public URL of THIS server (used to build absolute links). Must match what the macOS client's
# `official.baseURL` points at.
PUBLIC_BASE_URL=https://notchspi-api.vercel.app

# --- Storage ---
# Production: set a Postgres connection string (Neon/Supabase/RDS; use the POOLED URL on
# serverless). Falls back to SQLite locally, or an EPHEMERAL in-memory store on serverless.
# POSTGRES_URL=postgres://user:pass@host/db
# DATABASE_URL is an alias for POSTGRES_URL (some hosts inject this name).
# DATABASE_URL=postgres://user:pass@host/db
DB_PATH=./data/notchspi.db
# Vercel injects these; do not set them locally unless you are simulating serverless.
# VERCEL=1
# VERCEL_PROJECT_PRODUCTION_URL=notchspi-api.vercel.app
# Postgres TLS. Default VERIFIES the server certificate (verify-full) — the billing DB must not
# accept a MITM. Neon/Supabase verify against Node's built-in public roots with no extra config.
#   verify-full (default) — TLS + certificate verification
#   require               — TLS but NO verification (legacy; use only if you must and accept the risk)
#   disable               — no TLS (local/dev; `?sslmode=disable` in the URL implies this too)
# POSTGRES_SSL_MODE=verify-full
# Custom CA for providers not covered by the public roots (e.g. AWS RDS bundle, a private CA):
# POSTGRES_CA_CERT_FILE=/etc/secrets/pg-ca.pem
# ...or inline PEM (literal \n between lines is accepted):
# POSTGRES_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# --- Quota (题数额度制) ---
# The account balance is a number of QUESTIONS; one successful capture costs one question.
# One-time fixed30 grant; all compatibility inputs must remain exactly 30.
QUOTA_POLICY_VERSION=fixed30-2026-09-06
TRIAL_QUESTIONS=30
TRIAL_MIN_QUESTIONS=30
TRIAL_MAX_QUESTIONS=30
# Required in production. Mock local development may use ephemeral storage/keys.
REQUIRE_DURABLE_STORAGE=0
REQUEST_HMAC_KEYS_JSON={}
REQUEST_HMAC_KEY_VERSION=v1
# Independent once-per-minute reservation recovery. Requires a Vercel plan supporting
# minute schedules or an external authenticated scheduler; never use a client bearer here.
CRON_SECRET=
SCREEN_QUERY_ENABLED=0
EXPLANATION_ENABLED=0
ENABLED_SUPPORT_PROFILES=
MODEL_COST_CURRENCY=USD
# Question packs sold on the top-up page. `amount_cents` is the currency's smallest unit
# (JPY = whole yen; CNY/USD = cents). Malformed values fall back to the built-in catalog.
# PACKS_JSON=[{"id":"pack100","questions":100,"amount_cents":900},{"id":"pack300","questions":300,"amount_cents":2400},{"id":"pack1000","questions":1000,"amount_cents":6800}]
CURRENCY=CNY
CATALOG_VERSION=pricing-v1

# --- Model providers ---
# Control/legacy path: mock | deepseek | anthropic | openai. "mock" needs no key and streams a
# canned answer (dev/testing). Keep production control on Anthropic during the Objective rollout.
OFFICIAL_PROVIDER=mock
OFFICIAL_MODEL=claude-opus-4-8
OFFICIAL_MAX_TOKENS=4096
# Objective treatment path. Empty provider/model values inherit OFFICIAL_* exactly. A production
# DeepSeek treatment uses provider=deepseek and model=deepseek-v4-flash-vision-exp; requests that
# omit result_protocol remain on OFFICIAL_PROVIDER, including old clients and the control group.
OBJECTIVE_RESULT_V1_PROVIDER=
OBJECTIVE_RESULT_V1_MODEL=
OBJECTIVE_RESULT_V1_MAX_TOKENS=4096
# The DeepSeek vision model is required; text-only models reject image input. Keep this key in the
# server environment only. Merely storing the key does not activate DeepSeek traffic.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Required when either provider slot selects anthropic (the server holds it; clients never see it).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Required when either provider slot selects openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# --- Payments (Stripe Checkout) ---
# Setting STRIPE_SECRET_KEY activates real payments automatically. Prefer a RESTRICTED key
# (rk_..., Checkout Sessions read/write; Charges, Refunds, Disputes and expanded Balance
# Transactions read for financial reconciliation; no refund-creation permission needed).
# Create a webhook endpoint at <PUBLIC_BASE_URL>/webhooks/stripe listening to
# checkout.session.completed AND checkout.session.async_payment_succeeded
# (delayed methods settle on the second event), plus refund.created, refund.updated, refund.failed,
# charge.succeeded/updated/refunded and charge.dispute.created/updated/closed/funds_withdrawn/funds_reinstated.
# Refund reconciliation reads the current re_ object; verify the restricted key can read it.
# Deferred Checkout reconciliation reads the current cs_ object; verify that read permission too.
# Keep signing and API keys in sensitive deployment environment variables. Do not commit them.
# STRIPE_SECRET_KEY=rk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Without a Stripe key the dev stub remains (see below).
PAYMENT_PROVIDER=stub
# Manual-grant console. Empty = every /admin* path 404s. Required in production to grant comps.
# ADMIN_TOKEN=
# Internal only: GET /dl streams this DMG; GET /update relays this release JSON. Users never see these URLs.
# DMG_URL=https://github.com/RotteSya/notch-SPI/releases/latest/download/NotchSPI.dmg
# RELEASE_API_URL=https://api.github.com/repos/RotteSya/notch-SPI/releases/latest
# The stub top-up endpoint is unauthenticated and can credit any balance, so it is DISABLED by
# default (safe for production). Set to 1 ONLY for local development to exercise the top-up flow.
ALLOW_STUB_TOPUP=0

# --- Abuse limits (best-effort, in-memory; see src/rateLimit.ts) ---
# Defense in depth against free-quota farming and parallel-capture abuse. These live per server
# instance, so on serverless treat a platform WAF / edge rule as the real hard limit. Set to 0
# to disable a limit.
# Max anonymous device registrations per client IP per hour.
DEVICE_REG_PER_HOUR=30
# Max simultaneous in-flight captures for a single device token.
CAPTURE_CONCURRENCY_PER_TOKEN=3

# --- Objective Result V1 + anonymous reliability events ---
# Stable HMAC rollout in basis points (0...10000). Start and roll back at 0.
OBJECTIVE_RESULT_V1_BPS=0
# Required before BPS > 0. Keep secret and stable; rotating it reshuffles devices.
# OBJECTIVE_RESULT_EXPERIMENT_SALT=
CLIENT_CONFIG_REVISION=2026-objective-v1-r1
TELEMETRY_ENABLED=1
EVENT_BATCH_PER_MINUTE=30
# Optional internal cost catalog, kept versioned with usage rows. Rates are currency micros per
# one million tokens; `model` may be the configured model id or `provider:model`.
# Conservative DeepSeek peak pricing; cache-hit input is intentionally estimated at miss price.
# MODEL_PRICING_JSON=[{"model":"deepseek:deepseek-v4-flash-vision-exp","input_micros_per_million_tokens":440000,"output_micros_per_million_tokens":1320000}]
MODEL_PRICING_JSON=[]
MODEL_PRICING_VERSION=unset
# Production must set a daily model-cost ceiling and a per-attempt upper bound (integer
# currency micros). Unknown vendor usage consumes the per-attempt upper bound and is visible as
# unknown in the cost ledger; local mock mode leaves both at zero.
MODEL_DAILY_BUDGET_MICROS=0
# Fixed offset for the daily budget boundary; 480 resets at midnight Asia/Shanghai.
# Freeze currency and offset for a live budget period to avoid opening a second window.
MODEL_BUDGET_UTC_OFFSET_MINUTES=0
ATTEMPT_BUDGET_UPPER_MICROS=0

LOG_LEVEL=info
